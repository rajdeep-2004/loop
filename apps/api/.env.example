# Port the API listens on
PORT=4000
# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/campus
# Secret used to sign access tokens. At least 16 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me
# Folder where uploaded files are stored
UPLOAD_DIR=./uploads
# Max signup/login/refresh attempts per IP per minute
AUTH_RATE_LIMIT_MAX=20
